[
  {
    "id": "FZ-VALID-001",
    "target": "validate-mutation",
    "signature": "validate-mutation|seed|two-locals",
    "input": {
      "config": {
        "configVersion": 1,
        "setupCompleted": true,
        "manager": { "port": 7788 },
        "defaults": { "remoteWebPort": 8899, "localPortRange": [20000, 20050] },
        "hosts": {
          "gpu-1": {
            "enabled": true,
            "autoStart": false,
            "localPort": null,
            "remoteWebPort": 8899,
            "workdir": null,
            "inject": { "env": {}, "extraArgs": [], "patches": [] }
          },
          "gpu-2": {
            "enabled": true,
            "autoStart": true,
            "localPort": 20001,
            "remoteWebPort": null,
            "workdir": "~",
            "inject": { "env": { "DSH_DEBUG": "1" }, "extraArgs": ["--verbose"], "patches": ["a.patch"] }
          }
        }
      },
      "mutator": "two-locals",
      "mutatorSeed": 1,
      "garbage": [
        { "__proto__": { "polluted": true } },
        { "hosts": { "x": { "phase": "__proto__" } } },
        [null, { "constructor": { "prototype": { "polluted": 1 } } }]
      ]
    },
    "origin": "人工种入（P3 落地）：两台 local:true 是跨主机约束里最容易被漏掉的一条",
    "note": "垃圾输入那三条专打原型污染：__proto__ 作为字段名、嵌在 hosts 里、以及 constructor.prototype 链"
  },
  {
    "id": "FZ-VALID-002",
    "target": "validate-mutation",
    "signature": "validate-mutation|seed|range-reversed",
    "input": {
