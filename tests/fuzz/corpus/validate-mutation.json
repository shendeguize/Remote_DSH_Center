            "autoStart": false,
            "localPort": null,
            "remoteWebPort": null,
            "workdir": "/srv/work",
            "inject": { "env": {}, "extraArgs": [], "patches": [] }
          }
        }
      },
      "mutator": "range-reversed",
      "mutatorSeed": 7,
      "garbage": [
        "",
        { "defaults": { "localPortRange": ["1024", 65536] } },
        { "manager": { "port": 1.5 } }
      ]
