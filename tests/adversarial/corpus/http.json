[
  {
    "id": "AV-HTTP-001",
    "surface": "http",
    "entry": "origin",
    "boot": "ready",
    "request": { "method": "POST", "path": "/api/hosts/gpu-1/start" },
    "payload": "http://evil-canary.example",
    "canary": "evil-canary.example",
    "expect": { "status": 403, "code": "FORBIDDEN_ORIGIN", "noReflect": true, "phaseUnchanged": true },
    "origin": "issue #45：跨站页面替用户发写操作（简单请求不触发预检）"
  },
  {
    "id": "AV-HTTP-002",
    "surface": "http",
    "entry": "origin",
    "boot": "ready",
    "request": { "method": "POST", "path": "/api/hosts/gpu-1/start" },
    "payload": "null",
    "expect": { "status": 403, "code": "FORBIDDEN_ORIGIN", "phaseUnchanged": true },
    "origin": "issue #45：sandbox iframe / data: 文档发出的 Origin: null"
  },
  {
    "id": "AV-HTTP-003",
    "surface": "http",
    "entry": "origin",
    "boot": "ready",
    "request": { "method": "POST", "path": "/api/hosts/gpu-1/start" },
    "payload": "http://127.0.0.1.evil-canary.example",
    "canary": "evil-canary.example",
    "expect": { "status": 403, "code": "FORBIDDEN_ORIGIN", "noReflect": true, "phaseUnchanged": true },
    "origin": "红队 R1：子域名障眼法（前缀等于环回名的域名）"
  },
  {
    "id": "AV-HTTP-004",
    "surface": "http",
    "entry": "origin",
    "boot": "ready",
    "request": { "method": "POST", "path": "/api/hosts/gpu-1/start" },
    "payload": "https://127.0.0.1",
    "expect": { "status": 403, "code": "FORBIDDEN_ORIGIN", "phaseUnchanged": true },
    "origin": "红队 R1：换协议（https 页面对 http 服务发请求）"
  },
  {
    "id": "AV-HTTP-005",
    "surface": "http",
    "entry": "origin",
    "boot": "ready",
    "request": { "method": "POST", "path": "/api/hosts/gpu-1/start" },
    "payload": "http://127.0.0.1:1",
    "expect": { "status": 403, "code": "FORBIDDEN_ORIGIN", "phaseUnchanged": true },
    "origin": "红队 R1：同名不同端口（本机另一个服务被 XSS 后的跳板）"
  },
  {
    "id": "AV-HTTP-006",
    "surface": "http",
    "entry": "host",
    "boot": "ready",
    "request": { "method": "GET", "path": "/api/hosts" },
    "payload": "dsh.evil-canary.example",
    "canary": "evil-canary.example",
    "expect": { "status": 403, "code": "FORBIDDEN_HOST", "noReflect": true },
    "origin": "issue #45：DNS rebinding 的落地形态"
  },
  {
    "id": "AV-HTTP-007",
    "surface": "http",
    "entry": "host",
    "boot": "ready",
    "request": { "method": "GET", "path": "/app.js" },
    "payload": "dsh.evil-canary.example",
    "canary": "evil-canary.example",
    "expect": { "status": 403, "code": null, "noReflect": true },
    "origin": "issue #45：静态资源与 API 同一道 Host 闸（先判 Host 再看路由）"
  },
  {
    "id": "AV-HTTP-008",
    "surface": "http",
    "entry": "path",
    "boot": "ready",
    "request": { "method": "GET", "path": "/..%2f..%2fetc%2fpasswd" },
    "canary": "root:",
    "expect": { "statusIn": [403, 404], "noReflect": true },
    "origin": "issue #89 一族：目录穿越的编码形态"
  },
  {
    "id": "AV-HTTP-009",
    "surface": "http",
    "entry": "path",
    "boot": "ready",
    "request": { "method": "GET", "path": "/....//....//etc/passwd" },
    "canary": "root:",
    "expect": { "statusIn": [403, 404], "noReflect": true },
    "origin": "红队 R1：`....//` 折叠形态"
  },
  {
    "id": "AV-HTTP-010",
    "surface": "http",
    "entry": "path",
    "boot": "ready",
    "request": { "method": "GET", "path": "/api/hosts/%2e%2e%2f%2e%2e%2fetc%2fpasswd/log" },
    "expect": { "status": 404, "code": "NOT_FOUND" },
    "origin": "红队 R1：把穿越藏在主机名段里（解码后不许变成路径）"
  },
  {
    "id": "AV-HTTP-011",
    "surface": "http",
    "entry": "body",
    "boot": "ready",
    "request": { "method": "PUT", "path": "/api/hosts/gpu-1/config", "rawBody": "{\"enabled\":" },
    "expect": { "status": 400, "code": "VALIDATION" },
    "origin": "13 §1.1：截断的 JSON 只能是 VALIDATION，不许 500"
  },
  {
    "id": "AV-HTTP-012",
    "surface": "http",
    "entry": "body",
    "boot": "ready",
    "request": { "method": "PUT", "path": "/api/hosts/gpu-1/config", "body": { "__proto__": { "polluted": true } } },
    "expect": { "status": 400, "code": "VALIDATION", "noPrototypePollution": true },
    "origin": "red team R1：原型污染（schema 按 own key 判定）"
  },
  {
    "id": "AV-HTTP-013",
    "surface": "http",
    "entry": "body",
    "boot": "ready",
    "request": { "method": "PUT", "path": "/api/hosts/gpu-1/config", "body": { "localPort": 12345 } },
    "expect": { "status": 400, "code": "VALIDATION" },
    "origin": "13 §2：localPort 由 manager 分配，不接受提交"
  },
  {
    "id": "AV-HTTP-014",
    "surface": "http",
    "entry": "query",
    "boot": "ready",
    "request": { "method": "GET", "path": "/api/hosts/gpu-1/log?lines=0" },
    "expect": { "status": 400, "code": "VALIDATION" },
    "origin": "13 §2：lines 需为 1..10000 的整数"
  },
  {
    "id": "AV-HTTP-015",
    "surface": "http",
    "entry": "query",
    "boot": "ready",
    "request": { "method": "GET", "path": "/api/hosts/gpu-1/dsh-settings?x=1" },
    "expect": { "status": 400, "code": "VALIDATION" },
    "origin": "settings 接口只接受无 query 的固定资源（防缓存/代理歧义）"
  },
  {
    "id": "AV-HTTP-016",
    "surface": "http",
    "entry": "setup-gate",
    "boot": "setup-gate",
    "request": { "method": "POST", "path": "/api/hosts/gpu-1/start" },
    "expect": { "status": 409, "code": "SETUP_REQUIRED" },
    "origin": "13 §1.3：未初始化时白名单外全 409"
  },
  {
    "id": "AV-HTTP-017",
    "surface": "http",
    "entry": "setup-gate",
    "boot": "setup-gate",
    "request": { "method": "PUT", "path": "/api/config/defaults", "body": { "remoteWebPort": 9999 } },
    "expect": { "status": 409, "code": "SETUP_REQUIRED" },
    "origin": "红队 R1：绕过向导直接改全局默认"
  },
  {
    "id": "AV-HTTP-018",
    "surface": "http",
    "entry": "setup-gate",
    "boot": "setup-gate",
    "request": { "method": "GET", "path": "/api/hosts" },
    "expect": { "status": 200 },
    "origin": "反面算例：白名单内的读接口必须放行，否则向导自己也打不开"
  }
]
