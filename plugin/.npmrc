# 与 publishConfig.registry 一致；本机全局 npmrc 指镜像源，锁文件必须以官方源为准。
registry=https://registry.npmjs.org/

# dsh 官方包的 rc peer 森林（dsh-agent → dsh-invariants ^0.1.1-rc.2 与
# dsh-client-runtime → dsh-invariants ^0.0.1-rc.1 等互斥 pin）会让 npm 10 的
# 自动 peer 安装在 arborist 里崩溃（edgesOut null）。dev 环境不需要装出整片
# peer 森林——运行时 peers 由 dsh profile 树解析。偏离登记见 README。
legacy-peer-deps=true
